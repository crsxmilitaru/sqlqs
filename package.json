{
  "name": "sqlqs",
  "version": "0.6.0-preview",
  "description": "SQL Query Studio - A lightweight SQL editor",
  "author": "Cristian Militaru",
  "publisher": "crsx",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/crsxmilitaru/sqlqs.git"
  },
  "bugs": {
    "url": "https://github.com/crsxmilitaru/sqlqs/issues"
  },
  "homepage": "https://github.com/crsxmilitaru/sqlqs#readme",
  "keywords": [
    "sql",
    "editor",
    "query",
    "database",
    "tauri",
    "solidjs",
    "ai",
    "studio"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "npm run tauri:dev",
    "setup": "npm install && cargo fetch --manifest-path src-tauri/Cargo.toml && dotnet restore src-tauri/sidecar/Sqlqs.Sidecar.slnx",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "sidecar:build": "node scripts/build-sidecar.mjs",
    "sidecar:dev": "node scripts/dev-sidecar.mjs",
    "cargo:update": "cargo update --manifest-path src-tauri/Cargo.toml",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/**/*.{ts,tsx}",
    "lint:fix": "eslint src/**/*.{ts,tsx} --fix",
    "release": "node scripts/run-release-workflow.mjs",
    "release:preview": "gh workflow run preview.yml --ref dev"
  },
  "dependencies": {
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@fortawesome/fontawesome-free": "^7.3.1",
    "@google/genai": "^2.20.0",
    "@replit/codemirror-minimap": "^0.5.2",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-notification": "^2.4.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "@tauri-apps/plugin-window-state": "^2.4.1",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.14",
    "marked": "^18.0.11",
    "solid-js": "^1.9.15",
    "sql-formatter": "^15.8.2",
    "tauri-plugin-snap-layout": "^1.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@solidjs/testing-library": "^0.8.10",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.6",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-solid": "^0.17.0",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^4.1.11"
  }
}
